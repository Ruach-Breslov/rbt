# Public frontend subset. See `.env.master.example` for the canonical complete
# live-services inventory; never copy its secret sections into this file.

# Public site URL and optional GitHub project path.
NEXT_PUBLIC_SITE_URL=https://example.github.io/repository-name
NEXT_PUBLIC_BASE_PATH=/repository-name

# Public organization names. Provide the official form for every supported language.
NEXT_PUBLIC_ORGANIZATION_NAME_EN=Ruach Breslov
NEXT_PUBLIC_ORGANIZATION_NAME_HE=Ruach Breslov
NEXT_PUBLIC_ORGANIZATION_NAME_ES=Ruach Breslov
NEXT_PUBLIC_ORGANIZATION_NAME_FA=Ruach Breslov

# Public contact details.
NEXT_PUBLIC_CONTACT_EMAIL=info@ruachbreslov.org
NEXT_PUBLIC_CONTACT_PHONE=917-740-4509
NEXT_PUBLIC_CONTACT_ADDRESS=71-27 147th St, Flushing, NY 11367

# HTTPS origin of the separate secure API for Resend and RSVP storage.
# Never put Resend, Stripe secret, webhook, or database credentials in a NEXT_PUBLIC variable.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Public Cloudflare Turnstile site key. The matching secret belongs only in Worker secrets.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public Stripe-hosted donation links. The legacy field is only a fallback for
# older deployments. Card and billing data must remain on Stripe-hosted pages.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_ONE_TIME_PAYMENT_LINK=https://donate.stripe.com/replace-me
NEXT_PUBLIC_STRIPE_MONTHLY_PAYMENT_LINK_18=https://donate.stripe.com/replace-me
NEXT_PUBLIC_STRIPE_MONTHLY_PAYMENT_LINK_36=https://donate.stripe.com/replace-me
NEXT_PUBLIC_STRIPE_MONTHLY_PAYMENT_LINK_72=https://donate.stripe.com/replace-me
NEXT_PUBLIC_STRIPE_MONTHLY_PAYMENT_LINK_180=https://donate.stripe.com/replace-me
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/replace-me

# Up to three comma-separated 11-character YouTube video IDs and an optional channel URL.
NEXT_PUBLIC_YOUTUBE_VIDEO_IDS=
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@replace-me

# Optional local, repository-hosted hero photo enhanced by WebGPU. Start with / and keep the file in public/.
NEXT_PUBLIC_HERO_IMAGE=

# CI-only public Google Calendar iCal feed. This is not used by the browser.
GOOGLE_CALENDAR_ICAL_URL=
