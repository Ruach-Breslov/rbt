# Ruach Breslov live-services worksheet
#
# Copy this file to `.env.master.local`, enter the real values there, and never
# commit that local file. This is a handoff worksheet, not a runtime env file:
# do not load or upload it wholesale. Each section names the correct destination.
# Values marked PUBLIC are visible in the website bundle and are not secrets.

# =============================================================================
# OPERATOR ACCESS — SECRET; provisioning only, never deploy to the app or Worker
# =============================================================================

# Optional if authenticated interactively with `gh auth login`.
GITHUB_REPOSITORY=
GH_TOKEN=

# Keep the private key outside the repository. Record paths/fingerprint only;
# upload the `.pub` file to GitHub as the repository deploy key.
GITHUB_SSH_PRIVATE_KEY_PATH=
GITHUB_SSH_PUBLIC_KEY_PATH=
GITHUB_SSH_KEY_FINGERPRINT=
GIT_SSH_COMMAND=

# Optional if authenticated interactively with `npx wrangler login`.
# Prefer a scoped API token. Legacy Global API Key authentication requires both
# the Cloudflare login email and key; never enter a password or recovery code.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=

# Created during production provisioning; the ID must replace the inherited D1
# ID in wrangler.jsonc before deployment. These two values are not secrets.
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_D1_DATABASE_ID=

# =============================================================================
# FRONTEND — PUBLIC; GitHub Actions Variables and local `.env.local`
# =============================================================================

# Exact canonical HTTPS site URL. GitHub Pages supplies this automatically during
# its build; record the intended final URL here for setup and verification.
NEXT_PUBLIC_SITE_URL=

# Leave empty for a custom/root domain. GitHub Pages supplies a project path when
# the site is hosted at `owner.github.io/repository`.
NEXT_PUBLIC_BASE_PATH=

# Exact public HTTPS origin of the deployed Cloudflare Worker, without a path.
NEXT_PUBLIC_API_BASE_URL=

NEXT_PUBLIC_ORGANIZATION_NAME_EN=Ruach Breslov
NEXT_PUBLIC_ORGANIZATION_NAME_HE=Ruach Breslov
NEXT_PUBLIC_ORGANIZATION_NAME_ES=Ruach Breslov
NEXT_PUBLIC_ORGANIZATION_NAME_FA=Ruach Breslov

NEXT_PUBLIC_CONTACT_EMAIL=info@ruachbreslov.org
NEXT_PUBLIC_CONTACT_PHONE=917-740-4509
NEXT_PUBLIC_CONTACT_ADDRESS="71-27 147th St, Flushing, NY 11367"

# Cloudflare Turnstile public site key. Do not put the secret key here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Recommended donation flow: a Stripe-hosted buy.stripe.com Payment Link.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=

# One to three comma-separated 11-character video IDs; no YouTube API key needed.
NEXT_PUBLIC_YOUTUBE_VIDEO_IDS=
NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=

# Optional repository-hosted image path such as /media/hero.avif.
NEXT_PUBLIC_HERO_IMAGE=

# =============================================================================
# WORKER CONFIG — NOT SECRET; production values in `wrangler.jsonc` vars
# =============================================================================

# Comma-separated exact frontend origins, including https:// and no path.
ALLOWED_ORIGINS=

# The same origin as NEXT_PUBLIC_API_BASE_URL.
PUBLIC_API_URL=

# Full HTTPS page URL used after double-opt-in, normally the English homepage.
SUBSCRIPTION_CONFIRMATION_REDIRECT_URL=

ORGANIZATION_NAME=Ruach Breslov

# Comma-separated hostnames only (no scheme or path) accepted from Turnstile.
TURNSTILE_EXPECTED_HOSTNAMES=

# Owner-approved RSVP retention period, clamped by the Worker to 1–3650 days.
RSVP_RETENTION_DAYS=365

# =============================================================================
# WORKER SECRETS — SECRET; install individually with `wrangler secret put NAME`
# =============================================================================

# A newly generated random value of at least 32 characters, unique to production.
RATE_LIMIT_SALT=

# Cloudflare Turnstile secret matching NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Separate least-privilege Resend keys for sending and Contacts administration.
RESEND_TRANSACTIONAL_API_KEY=
RESEND_CONTACTS_API_KEY=

# Sender must use the verified Resend domain. Destination is never browser-set.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=info@ruachbreslov.org

# IDs for the Resend Newsletter and Event announcements Topics.
RESEND_NEWSLETTER_TOPIC_ID=
RESEND_EVENTS_TOPIC_ID=

# Signing secret for https://YOUR_API_HOST/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# =============================================================================
# OPTIONAL CUSTOM STRIPE CHECKOUT — SECRET except the Price ID
# Leave all three empty when using only NEXT_PUBLIC_STRIPE_PAYMENT_LINK.
# =============================================================================

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Signing secret for https://YOUR_API_HOST/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
