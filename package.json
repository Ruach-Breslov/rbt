{
  "name": "ruach-breslov-main-site",
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:static-export": "node scripts/check-static-export.mjs",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:tests": "tsc -p worker/test/tsconfig.json && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "test:worker": "vitest run --config vitest.worker.config.mts",
    "test:e2e": "playwright test",
    "test": "npm run test:worker && npm run test:e2e",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply organization-website --local",
    "db:migrate:remote": "wrangler d1 migrations apply organization-website --remote",
    "db:seed:local": "wrangler d1 execute organization-website --local --file worker/seeds/dev.sql",
    "check": "npm run audit && npm run typecheck && npm run typecheck:worker && npm run typecheck:tests && npm run lint && npm run test:worker && npm run build && npm run check:static-export"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.3.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "autoprefixer": "^10.5.0",
    "lucide-react": "^1.14.0",
    "next": "^16.3.3",
    "postcss": "^8.5.26",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
